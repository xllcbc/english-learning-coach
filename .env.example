SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/writelab
SPRING_DATASOURCE_USERNAME=writelab
SPRING_DATASOURCE_PASSWORD=writelab
WRITELAB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Copy this file to .env at the repo root. The backend imports it automatically at startup.
# Leave WRITELAB_MODEL_API_KEY empty to run in deterministic Mock mode.
WRITELAB_MODEL_BASE_URL=https://api.openai.com
WRITELAB_MODEL_API_KEY=
WRITELAB_MODEL_NAME=gpt-4o-mini
# Per HTTP call; the SDK retries timeouts, so the worst-case wait is timeout x (1 + max-retries).
WRITELAB_MODEL_TIMEOUT=120s
WRITELAB_MODEL_MAX_RETRIES=1
